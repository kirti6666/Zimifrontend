{
  "name": "aurora-live-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:onboarding": "node scripts/test-onboarding.cjs",
    "test:api-adapter": "node scripts/test-api-adapter.cjs",
    "test:media": "node scripts/test-api-adapter.cjs && node scripts/test-profile-media.cjs",
    "test:auth": "node scripts/test-api-client.cjs && node scripts/test-api-adapter.cjs && node scripts/test-auth-bridge.cjs",
    "test:render-security": "node scripts/test-render-security.cjs",
    "test:home": "npm run build:web && node scripts/test-home.cjs && node scripts/test-home-media.cjs",
    "test:live": "npm run build:web && node scripts/test-live-room.cjs && node scripts/test-home-media.cjs",
    "test:call-setup": "npm run build:web && node scripts/test-call-setup.cjs",
    "test:call-charges": "npm run build:web && node scripts/test-call-charges.cjs",
    "test:private-screens": "npm run build:web && node scripts/test-private-screens.cjs",
    "test:chat-safety": "npm run build:web && node scripts/test-chat-safety.cjs",
    "test:chat-actions": "npm run build:web && node scripts/test-chat-actions.cjs",
    "test:verification": "npm run build:web && node scripts/test-verification-call.cjs",
    "test:loading": "npm run build:web && node scripts/test-loading.cjs",
    "test:offline": "npm run build:web && node scripts/test-offline.cjs",
    "test:chats": "npm run build:web && node scripts/test-chats.cjs",
    "test:navigation": "npm run build:web && node scripts/test-navigation.cjs",
    "test:themes": "npm run build:web && node scripts/test-themes.cjs",
    "test:theme-consistency": "npm run build:web && node scripts/test-theme-consistency.cjs",
    "test:profile-settings": "npm run build:web && node scripts/test-profile-settings.cjs",
    "test:public-profile": "npm run build:web && node scripts/test-public-profile.cjs",
    "test:icons": "npm run build:web && node scripts/test-icons.cjs",
    "build:admin": "node scripts/build-admin.mjs"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-haptics": "~57.0.3",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "playwright": "1.63.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.9.3"
  }
}
