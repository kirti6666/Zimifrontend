{
  "expo": {
    "name": "Zimi Live",
    "slug": "aurora-live-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurora.liveapp",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        },
        "NSCameraUsageDescription": "Zimi Live uses your camera when you choose to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Zimi Live lets you choose photos from your library for your profile."
      }
    },
    "android": {
      "package": "com.aurora.liveapp",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/with-onboarding-camera",
      "./plugins/with-development-network"
    ]
  }
}
