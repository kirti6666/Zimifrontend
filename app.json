{
  "expo": {
    "name": "BinzoLive",
    "slug": "aurora-live-app",
    "scheme": "binzolive",
    "version": "1.0.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/icon.png",
    "web": {
      "favicon": "./web/favicon/favicon-96x96.png"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurora.liveapp",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        },
        "NSCameraUsageDescription": "BinzoLive uses your camera when you take a chat or profile photo, start a video call, or host a live broadcast.",
        "NSMicrophoneUsageDescription": "BinzoLive uses your microphone when you record a voice message, start or join an audio or video call, or host a live broadcast.",
        "NSPhotoLibraryUsageDescription": "BinzoLive lets you choose photos from your library to send in chats or add to your profile.",
        "NSPhotoLibraryAddUsageDescription": "BinzoLive saves a chat photo to your library when you tap Download."
      }
    },
    "android": {
      "package": "com.aurora.liveapp",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#00000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#EC0785",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "BinzoLive saves a chat photo to your library when you tap Download.",
          "photosPermission": "BinzoLive lets you choose photos from your library to send in chats or add to your profile.",
          "granularPermissions": []
        }
      ],
      "./plugins/with-onboarding-camera",
      "./plugins/with-development-network",
      "./plugins/with-apk-updater",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}
