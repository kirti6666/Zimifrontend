# Copy to .env and fill in. Read by the app at build time (Expo EXPO_PUBLIC_ vars).
# API base including /api/v1, no trailing slash. Production requires HTTPS.
EXPO_PUBLIC_API_URL=https://api.binzolive.com/api/v1
# Socket.IO server origin. Optional: defaults to the API origin.
# EXPO_PUBLIC_SOCKET_URL=https://api.binzolive.com
# Local debug on a physical device: use your computer's LAN address on the same Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.1.6:5000/api/v1
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.6:5000
# USB development (works even when the phone and PC use different Wi-Fi networks):
# EXPO_PUBLIC_API_URL=http://127.0.0.1:5000/api/v1
# EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:5000
# npm start / npm run android restore API and Metro USB tunnels automatically.
