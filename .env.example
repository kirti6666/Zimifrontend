# Copy to .env and fill in. Read by the app at build time (Expo EXPO_PUBLIC_ vars).
# Base address of the Zimi Live server, no trailing slash.
EXPO_PUBLIC_API_URL=https://api.zimilive.in
# Live events socket. Optional: defaults to <API_URL>/ws over wss.
# EXPO_PUBLIC_SOCKET_URL=wss://api.zimilive.in/ws
