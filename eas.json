{
  "cli": { "version": ">= 5.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.binzolive.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.binzolive.com"
      }
    }
  },
  "submit": { "production": {} }
}
